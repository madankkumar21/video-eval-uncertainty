# Copy to .env and fill in. .env is gitignored.
# Locally either name works. In a Claude Code cloud environment, use VEU_ANTHROPIC_API_KEY
# so the key is only read by this project's code, not by Claude Code itself.
VEU_ANTHROPIC_API_KEY=
# Optional: set to "off" to bypass the local result cache (used to measure each engine's native resume)
VEU_CACHE=on
